#!/bin/sh
# Хук systemd-shutdown: погасить LED и снять 3.3 В M.2.
#   /usr/lib/systemd/system-shutdown/cut-vcc3v3-pcie -> этот файл
# systemd вызывает его с аргументом halt|poweroff в самом конце выключения,
# когда ФС уже размонтированы или переведены в ro.
#
# Без аргумента (старый аварийный вызов из UI) — ничего не делаем: корень
# лежит на NVMe, снимать его под смонтированной на запись ФС нельзя.
#
# После удаления PCI-устройства диск недоступен, поэтому ниже только
# встроенные команды sh (echo, read, [ ]) — ни одной программы с диска.
case "${1:-}" in
  poweroff|halt) ;;
  *) exit 0 ;;
esac

for t in /sys/class/leds/*/trigger; do
  echo none > "$t" 2>/dev/null || true
done
for b in /sys/class/leds/*/brightness; do
  echo 0 > "$b" 2>/dev/null || true
done

for d in /sys/bus/pci/devices/*/remove; do
  [ -w "$d" ] || continue
  echo 1 > "$d" 2>/dev/null || true
done

# Путь через симлинк driver: readlink с диска уже не запустить.
dev=/sys/bus/platform/devices/3c0000000.pcie
if [ -e "$dev/driver/unbind" ]; then
  echo 3c0000000.pcie > "$dev/driver/unbind" 2>/dev/null || true
fi

for r in /sys/class/regulator/regulator.*; do
  [ -r "$r/name" ] || continue
  name=
  read -r name < "$r/name" 2>/dev/null || true
  [ "$name" = "vcc3v3_pcie_p" ] || continue
  echo 0 > "$r/enable" 2>/dev/null || true
done

exit 0
