# FOTEK ONYX Plymouth theme — fullscreen start.png + slow pulsing dots.

bg_image = Image("start.png");
bg_sprite = Sprite();
bg_sprite.SetImage(bg_image.Scale(Window.GetWidth(), Window.GetHeight()));
bg_sprite.SetX(0);
bg_sprite.SetY(0);
bg_sprite.SetZ(-10000);

dot_image = Image("progress-dot.png");
dot_sprites = [];
dot_count = 3;
dot_spacing = 40;
dot_base_x = Window.GetWidth() / 2 - ((dot_count - 1) * dot_spacing) / 2;
dot_y = Window.GetHeight() * 0.82;

for (i = 0; i < dot_count; i = i + 1) {
    dot_sprites[i] = Sprite(dot_image);
    dot_sprites[i].SetX(dot_base_x + i * dot_spacing - dot_image.GetWidth() / 2);
    dot_sprites[i].SetY(dot_y - dot_image.GetHeight() / 2);
    dot_sprites[i].SetOpacity(0.25);
}

frame = 0;

fun refresh_callback ()
{
    frame = frame + 1;
    # ~3–4 Hz: one full cycle across three dots takes ~1.5–2 s
    active = (frame / 18) % dot_count;

    for (i = 0; i < dot_count; i = i + 1) {
        if (i == active)
            dot_sprites[i].SetOpacity(1.0);
        else
            dot_sprites[i].SetOpacity(0.25);
    }
}

Plymouth.SetRefreshFunction(refresh_callback);

fun message_callback (text)
{
}

fun display_normal_callback ()
{
}

fun display_password_callback (prompt, bullets)
{
}

Plymouth.SetMessageFunction(message_callback);
Plymouth.SetDisplayNormalFunction(display_normal_callback);
Plymouth.SetDisplayPasswordFunction(display_password_callback);
